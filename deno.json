{
  "imports": {
    "@ngrok/ngrok": "npm:@ngrok/ngrok@^1.5.1",
    "@std/csv": "jsr:@std/csv@^1.0.6",
    "@std/fs": "jsr:@std/fs@^1.0.17",
    "@std/json": "jsr:@std/json@^1.0.2",
    "@std/path": "jsr:@std/path@^1.0.9",
    "@std/streams": "jsr:@std/streams@^1.0.9",
    "@std/yaml": "jsr:@std/yaml@^1.0.6",
    "@workingdevshero/deno-imap": "jsr:@workingdevshero/deno-imap@^1.0.0",
    "cheerio": "npm:cheerio@^1.0.0",
    "get-stream": "npm:get-stream@^9.0.1",
    "hono": "jsr:@hono/hono@^4.7.10",
    "open": "npm:open@^10.1.2",
    "pino": "npm:pino@^9.6.0",
    "playwright": "npm:playwright@^1.52.0",
    "postal-mime": "npm:postal-mime@^2.4.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/package/xlsx.mjs"
