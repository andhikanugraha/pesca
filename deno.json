  "unstable": ["temporal"],
  "tasks": {
    "main": "deno --allow-read --allow-write --allow-sys --allow-env --allow-run --allow-net --allow-ffi --allow-import=\"cdn.sheetjs.com:443,jsr.io:443\" index.ts",
